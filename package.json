{
  "name": "sihebat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js && tailwindcss -c tailwind.config.js -i src/tailwind.css -o dist/css/tailwind.css --minify",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
